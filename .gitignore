# 仅版本管理服务端源码、规则、工具和资料。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SERVER.md
!/go.mod
!/go.sum
!/cmd/
!/internal/
!/deploy/
!/out/

# 客户端原包、原生运行时和构建缓存在本机/服务器单独保管。
/internal/nativepvp/runtime/
**/__pycache__/
*.pyc
*.pyo
*.exe
*.dll
*.so
*.nupkg
*.zip
*.apk
*.npk
*.log
*.bak
*.tmp

# 密钥、账号、存档和本机授权不得进入仓库。
*.pem
*.key
*.keystore
**/script_key.txt
/deploy/keys/
/deploy/data/accounts.dev.json
/deploy/data/resources/
/out/*
!/out/*.md
!/out/references/
/out/references/*
!/out/references/*.md
!/out/tools/
/out/tools/*
!/out/tools/*.py
!/out/tools/*.ps1
!/out/tools/*.cmd
!/out/tools/*.sh

# 与服务端交付无关的个人机器、客户端打包和记忆维护工具。
/deploy/mumu_direct_login.py
/deploy/client_direct_login.py
/deploy/data/login_key.pub.txt
/out/tools/save_authorized_handoff_memory.py
/out/tools/audit_c_capacity.py
/out/tools/build_apk.py
/out/tools/build_apk_protocol_asset.py
/out/tools/inspect_direct_login.py
/out/tools/snapshot_direct_login.py
/out/tools/domain_rewrite.py
/out/tools/dex_rewrite.py
/out/tools/dex_short_patch.py
